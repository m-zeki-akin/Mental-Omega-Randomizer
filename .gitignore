__pycache__/
*.pyc

# Runtime/test artifacts generated by the launcher.
backups/
extracted_maps/
generated_maps/
cameo_cache/
randomizer_state.json
shop_profile.json
shop_run.json
shop_transaction.json
self_check.json
RandomizerLauncherData/
logs/
bugreports/
build/
dist/
release/
*.spec

# Published Archipelago package. Intermediate build trees stay ignored.
!Archipelago/*.apworld

# Local Codex maintenance memory; never distribute with the launcher.
AGENTS.md

# Local player setup. Keep templates/docs in source, not personal seeds.
configs/player/mental_omega_randomizer.yaml
# Legacy path retained only so older source checkouts remain private during migration.
config/mental_omega_randomizer.yaml
PROJECT_CONTEXT.md
assets/Campaign Only Units For All Factions.ini
price_audit/

# The pristine reference material the authenticity manifest is built from.
# 90 MB of it, and the manifest is 210 KB, so only the manifest is tracked.
configs/maps/
configs/*-original.ini
# And the builder that turns them into configs/rules_digest.json. The
# shipped table only means anything while the player cannot rebuild it
# from their own modified files.
tools/build_rules_digest.py

# Per-machine runtime artefacts. The authenticity cache is file stamps
# from one installation and self_check.json is one run's report; both
# land beside the launcher and neither means anything anywhere else.
authenticity_cache.json
self_check.json
configs/Mix-Unprotect*.exe

# Machine-specific build variant. The committed build_exe.ps1 pins the
# Python and Tcl/Tk the release is built against; a maintainer whose
# toolchain differs keeps their adaptation here and deploy.ps1 picks it
# up, without that adaptation reaching anyone else.
build_exe.local.ps1
dist/

# CodeGraph's local index. A per-machine database and its daemon files;
# indexing is each maintainer's own decision.
.codegraph/
